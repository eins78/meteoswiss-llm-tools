    {
      "name": "meteoswissClimateData",
      "description": "Get homogeneous climate measurement series from Switzerland's National Basic Climatic Network (NBCN). Returns temperature, precipitation, sunshine, radiation, wind, pressure, and climate indicators (frost days, summer days, heat days) going back decades.\n\n29 climate stations + 46 precipitation stations with daily, monthly, and yearly resolution.\n\nUse cases: \"What are typical January temperatures in Zurich?\", \"How has precipitation changed in Basel over 50 years?\", \"How many heat days did Lugano have last year?\"\n\nAccepts station names (\"Zurich\", \"Basel\"), abbreviations (\"SMA\", \"BAS\"), or WGS84 coordinates.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "station": {
            "description": "Climate station name or abbreviation (e.g., \"Zurich\", \"BAS\", \"Davos\"). Part of the National Basic Climatic Network (29 climate + 46 precipitation stations). Provide either this or `coordinates`; if both are given, `coordinates` takes precedence.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "coordinates": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": 45.5,
                "maximum": 48,
                "description": "WGS84 latitude"
              },
              "lon": {
                "type": "number",
                "minimum": 5.9,
                "maximum": 10.6,
                "description": "WGS84 longitude"
              }
            },
            "required": [
              "lat",
              "lon"
            ],
            "description": "WGS84 coordinates (alternative to station name)"
          },
          "resolution": {
            "default": "monthly",
            "description": "Data resolution: daily (temp min/max/mean), monthly (full climate summary), yearly (annual summary)",
            "type": "string",
            "enum": [
              "daily",
              "monthly",
              "yearly"
            ]
          },
          "start_date": {
            "description": "Start date filter (YYYY-MM-DD). Only rows on or after this date are returned.",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end_date": {
            "description": "End date filter (YYYY-MM-DD). Only rows on or before this date are returned.",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "limit": {
            "default": 30,
            "description": "Maximum number of data rows to return (default 30)",
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "station": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Climate station name"
              },
              "abbreviation": {
                "type": "string",
                "description": "Official station abbreviation (e.g. \"SMA\")"
              },
              "elevation": {
                "type": "number",
                "description": "Elevation in metres above sea level"
              },
              "coordinates": {
                "type": "object",
                "properties": {
                  "lat": {
                    "type": "number"
                  },
                  "lon": {
                    "type": "number"
                  }
                },
                "required": [
                  "lat",
                  "lon"
                ],
                "additionalProperties": false,
                "description": "WGS84 coordinates of the station"
              },
              "canton": {
                "description": "Canton abbreviation (e.g. \"ZH\")",
                "type": "string"
              },
              "distance_km": {
                "description": "Distance from the queried location to this station, km (when resolved by proximity)",
                "type": "number"
              },
              "network": {
                "type": "string",
                "description": "NBCN network kind: \"nbcn\" (full climate series) or \"nbcn-precip\" (precipitation-only)"
              }
            },
            "required": [
              "name",
              "abbreviation",
              "elevation",
              "coordinates",
              "network"
            ],
            "additionalProperties": false
          },
          "resolution": {
            "type": "string",
            "enum": [
              "daily",
              "monthly",
              "yearly"
            ],
            "description": "Resolution the returned rows are in"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "description": "Measurement date (YYYY-MM-DD; first day of period for monthly/yearly)"
                },
                "temperature_mean": {
                  "description": "Mean temperature, °C",
                  "type": "number"
                },
                "temperature_max": {
                  "description": "Maximum temperature, °C",
                  "type": "number"
                },
                "temperature_min": {
                  "description": "Minimum temperature, °C",
                  "type": "number"
                },
