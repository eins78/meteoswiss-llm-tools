{
  "name": "meteoswiss-mcp",
  "mcpName": "io.github.eins78/meteoswiss-mcp",
  "version": "3.0.0",
  "description": "MCP server for MeteoSwiss weather data — forecasts, real-time measurements, stations, pollen.",
  "license": "CC0-1.0",
  "author": "Max F. Albrecht <1@178.is>",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "src/views",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec 'tsx src/index.ts'",
    "ci": "pnpm run lint && pnpm run build && pnpm run test",
    "dist": "pnpm run clean && pnpm run build && pnpm run test",
    "lint": "pnpm run lint:ts && pnpm run lint:eslint && pnpm run lint:parity",
    "fix": "pnpm run lint:eslint --fix",
    "lint:ts": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint:eslint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:parity": "tsx scripts/lint-skills-parity.ts",
    "parity:update": "tsx scripts/lint-skills-parity.ts --update",
    "start": "node dist/index.js",
    "dev:inspect": "npx @modelcontextprotocol/inspector http://localhost:3000/mcp",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "pnpm run test --watch",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest test/integration",
    "build": "tsc",
    "dev:docker": "pnpm run build:docker && pnpm run start:docker",
    "build:docker": "docker build -t meteoswiss-mcp:dev .",
    "start:docker": "docker run meteoswiss-mcp:dev",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eins78/meteoswiss-llm-tools.git",
    "directory": "packages/meteoswiss-mcp"
  },
  "keywords": [
    "mcp",
    "weather",
    "meteoswiss",
    "switzerland",
    "open-data"
  ],
  "bugs": {
    "url": "https://github.com/eins78/meteoswiss-llm-tools/issues"
  },
  "homepage": "https://meteoswiss-mcp.ars.is",
  "dependencies": {
    "@eins78/styles": "^1.0.0",
    "@epic-web/cachified": "^5.6.3",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.0",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "jsdom": "^24.1.3",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "prom-client": "^15.1.3",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "write-file-atomic": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "^0.22.0",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^25.5.0",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "jest-environment-node": "^30.3.0",
    "js-yaml": "^5.2.2",
    "mcp-remote": "^0.1.38",
    "nock": "^14.0.11",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
