<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- start-viewer.sh pins the viewer to 127.0.0.1 (scripts/loopback-listen.cjs) and no longer manages
     `tailscale serve`; the tailnet mapping is a one-time setup, see the package README. -->
<dict>
    <key>Label</key>
    <string>li.kiste.meteoswiss-evals-viewer</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/user/CODE/mcp-server-meteoswiss/packages/meteoswiss-forecast-evals/scripts/start-viewer.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/user/CODE/mcp-server-meteoswiss/packages/meteoswiss-forecast-evals</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/Users/user/Library/Logs/meteoswiss-evals-viewer.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/user/Library/Logs/meteoswiss-evals-viewer.log</string>
</dict>
</plist>
